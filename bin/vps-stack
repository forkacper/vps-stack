#!/usr/bin/env bash
# Thin dispatcher: vps-stack <command> [arguments]
set -euo pipefail

# Resolve symlinks, so /usr/local/bin/vps-stack -> <repo>/bin/vps-stack works.
SELF="${BASH_SOURCE[0]}"
while [[ -L "${SELF}" ]]; do
    LINK_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
    SELF="$(readlink "${SELF}")"
    [[ "${SELF}" == /* ]] || SELF="${LINK_DIR}/${SELF}"
done
REPO_ROOT="$(cd "$(dirname "${SELF}")/.." && pwd)"
SCRIPTS_DIR="${REPO_ROOT}/scripts"

usage() {
    cat <<USAGE
vps-stack $(cat "${REPO_ROOT}/VERSION" 2>/dev/null || printf 'unknown version')

Usage: vps-stack <command> [arguments]

Server:
  provision      prepare a fresh server (run as root)
  ssh-port       change the SSH port in a safe order
  verify         check the state of the server (read-only)
  check-ports    look for ports reachable from the internet besides SSH, 80 and 443

Sites:
  add-site       add a domain to the proxy
  remove-site    remove a domain from the proxy
  list-sites     list the configured sites
  check-dns      check that a domain points at this server

Services:
  proxy          up | down | restart | reload | validate | status | logs | network-ipv6
  backup         init | run | list | snapshots | restore | export | setup
  deploy         init | run | rollback | status | key
  monitor        optional status page: enable | disable | password | status

Other:
  version        print the version
  help           this help

Every command accepts --help. Documentation: ${REPO_ROOT}/docs/
USAGE
}

main() {
    local command="${1:-help}"
    [[ $# -gt 0 ]] && shift
    case "${command}" in
        provision | ssh-port | add-site | remove-site | list-sites | check-dns | check-ports | verify | proxy | backup | deploy | monitor)
            exec "${SCRIPTS_DIR}/${command}.sh" "$@"
            ;;
        version | --version | -V)
            cat "${REPO_ROOT}/VERSION"
            ;;
        help | --help | -h)
            usage
            ;;
        *)
            usage >&2
            printf '\nUnknown command: %s\n' "${command}" >&2
            exit 2
            ;;
    esac
}

main "$@"
