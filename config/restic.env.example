# vps-stack: backup repository (restic). Lives at /etc/vps-stack/restic.env,
# mode 600. This file is NOT part of the backup: keep its content and the
# repository password in a password manager as well.
#
# The repository has to live OUTSIDE the provider of this VPS. A backup on
# the same server (or in the same account) is not a backup.
#
# Format: KEY=value, comments only on their own lines.

# --- Option A: S3-compatible storage ------------------------------------------
# RESTIC_REPOSITORY=s3:https://s3.example.com/example-bucket/vps-stack
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Option B: SFTP -----------------------------------------------------------
# Needs the SSH key of this server's root added on the target server and one
# manual connection first (to accept the host key).
# RESTIC_REPOSITORY=sftp:backup@backup.example.com:/srv/restic/vps-stack

RESTIC_REPOSITORY=

# File with the repository password (mode 600). Default location:
RESTIC_PASSWORD_FILE=/etc/vps-stack/restic.password

# Optional: ping URL of a healthchecks.io style monitor.
# The script calls <HC_URL>/start, and at the end <HC_URL> or <HC_URL>/fail.
HC_URL=
