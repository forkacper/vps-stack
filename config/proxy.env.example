# vps-stack: proxy (Caddy) settings. Lives at /etc/vps-stack/proxy.env,
# mode 600. If you put a proxy.env next to the stack.env passed with
# --config, provisioning copies it for you.
#
# Format: KEY=value, comments only on their own lines.

# REQUIRED: e-mail address of the ACME account (Let's Encrypt sends
# certificate warnings to it). Example: admin@example.com
ACME_EMAIL=

# Certificate authority. Empty = Let's Encrypt production.
# For testing use the staging environment (untrusted certificates, but no
# risk of running into rate limits):
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# After testing clear the value and run: vps-stack proxy up
ACME_CA=
