# vps-stack: provisioning parameters.
#
# Copy this file, fill it in and pass it on the first run:
#   sudo ./bin/vps-stack provision --config ./stack.env
# The script saves it as /etc/vps-stack/stack.env (mode 600) and later runs
# read only that file.
#
# Format: KEY=value, one pair per line. Comments only on their own lines
# (a comment after a value would be taken as part of the value).

# Administrator: an account with sudo, SSH login by key only. Not "admin":
# Ubuntu cloud images already have a group with that name, and provisioning
# refuses a name that is taken by a group.
ADMIN_USER=sysadmin

# Deployment account: no sudo.
DEPLOY_USER=deploy

# Whether DEPLOY_USER belongs to the docker group.
# WARNING: membership of the docker group is equivalent to root privileges.
# false = the administrator runs deployments; true = more convenient
# deployments, at the price that a compromised deploy account means a
# compromised server.
DEPLOY_IN_DOCKER_GROUP=false

# REQUIRED: path to a file with the administrator's public key (on the
# server, e.g. /root/admin.pub). The script does not start without it.
ADMIN_SSH_PUBKEY_FILE=

# Optional: public key of the deployment account.
DEPLOY_SSH_PUBKEY_FILE=

# The port sshd listens on NOW. Provisioning does not change the port.
# Change it later with a separate command: vps-stack ssh-port <port>
SSH_PORT=22

# Your IP addresses (separated by spaces) that fail2ban must never ban.
FAIL2BAN_IGNOREIP=

# Swap file size, e.g. 2G or 512M. 0 disables swap creation.
SWAP_SIZE=2G

# Host name of the server, e.g. srv1.example.com (or just srv1): the prompt,
# the logs, the status page and the backup snapshots show it. Empty = keep the
# name the provider gave the server. It is local only: for
# `ssh srv1.example.com` add a DNS record yourself.
SERVER_HOSTNAME=

TIMEZONE=Etc/UTC

# Automatic reboot after updates that need one (at 04:00).
# false = you reboot yourself; `vps-stack verify` reminds you when.
AUTO_REBOOT=false

# Name of the shared Docker network that connects the proxy to the web
# containers of the projects.
PROXY_NETWORK=proxy
