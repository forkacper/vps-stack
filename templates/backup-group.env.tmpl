# vps-stack: backup group "{{NAME}}". Created by `vps-stack backup init {{NAME}}`.
# Mode 600. Format: KEY=value, comments only on their own lines.

# Where the restic repository lives. The default is a directory on this
# server: it protects against mistakes in the application and bad
# deployments, not against losing the server. To keep the copies elsewhere
# instead, put the address of another backend here, for example
#   RESTIC_REPOSITORY=s3:https://s3.example.com/example-bucket/{{NAME}}
#   RESTIC_REPOSITORY=sftp:backup@backup.example.com:/srv/restic/{{NAME}}
# and see docs/backup-restore.md ("Copies outside the server").
RESTIC_REPOSITORY={{REPOSITORY}}

# The repository password, generated by `backup init`. You never type it.
# When the repository moves off this server, save the password in your
# password manager as well: without it the copies cannot be read.
RESTIC_PASSWORD_FILE={{PASSWORD_FILE}}

# Credentials of a remote backend, only when RESTIC_REPOSITORY needs them:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Snapshots kept after every backup.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# Optional: ping URL of a healthchecks.io style monitor. The script calls
# <HC_URL>/start, and at the end <HC_URL> or <HC_URL>/fail.
HC_URL=
