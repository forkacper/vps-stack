# vps-stack: deploy of the project "{{NAME}}". Created by
# `vps-stack deploy init {{NAME}}`. Mode 600. Format: KEY=value, comments
# only on their own lines.

# Where the image comes from:
#   image   it is built elsewhere (e.g. by CI) and pushed to a registry; the
#           server pulls it. Recommended: a build never takes memory from
#           the running projects.
#   build   the project directory is a git clone; the server checks out the
#           commit and builds the image itself.
DEPLOY_MODE={{MODE}}

# The variable in the project's .env that the compose file uses as the image
# tag, e.g. image: ghcr.io/example-owner/{{NAME}}:${APP_TAG}. A deploy sets
# it to the version being deployed.
DEPLOY_TAG_VAR={{TAG_VAR}}

# Only when the compose file is not compose.yaml or docker-compose.yml:
# its path, relative to the project directory.
DEPLOY_COMPOSE_FILE={{COMPOSE_FILE}}

# Database migrations, run in a one-off container of the new version before
# the containers are replaced. Leave the service empty for none. The command
# is split on spaces and is not interpreted by a shell: no quotes, pipes or
# variables. Anything more complex belongs in a script inside the image.
DEPLOY_MIGRATE_SERVICE={{MIGRATE_SERVICE}}
DEPLOY_MIGRATE_COMMAND={{MIGRATE_COMMAND}}

# true = back up the project (vps-stack backup run {{NAME}}) before every
# deploy, so that a bad migration can be undone. Needs the backup group:
# sudo vps-stack backup init {{NAME}}
DEPLOY_BACKUP={{BACKUP}}

# Seconds to wait for the new containers to become healthy before the deploy
# counts as failed and the previous version is started again.
DEPLOY_HEALTH_TIMEOUT={{HEALTH_TIMEOUT}}
