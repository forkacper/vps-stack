#!/usr/bin/env bash
# Example backup hook: dump of a MySQL or MariaDB database from a project
# container.
#
# Installation, for the project "example-app":
#   sudo vps-stack backup init example-app
#   sudo install -m 700 examples/backup-hook-mysql.sh.example /etc/vps-stack/hooks/example-app/db.sh
#   (the file name without .sh becomes the hook name and its dump directory)
#
# Contract (variables set by `vps-stack backup run`):
#   BACKUP_GROUP           the project, e.g. example-app
#   PROJECT_DIR            its directory, e.g. /srv/example-app
#   STAGING_DIR            the project's staging directory; write dumps to
#                          $STAGING_DIR/$HOOK_NAME/
#   HOOK_NAME              hook name
#   HOOK_EXTRA_PATHS_FILE  file to which additional paths may be appended
# The hook has to fail when the dump is empty or incomplete.
#
# The dump is plain SQL, not gzip: restic compresses it and stores only what
# changed since the previous dump. A compressed dump looks entirely new every
# time and would take its full size in the repository on every run.
#
# pipefail is essential: without it a dump error in a pipe would be masked.
set -euo pipefail

: "${PROJECT_DIR:?the hook is started by: vps-stack backup run}"
: "${STAGING_DIR:?the hook is started by: vps-stack backup run}"
: "${HOOK_NAME:?the hook is started by: vps-stack backup run}"

# The directory holding the project's docker-compose.yml is PROJECT_DIR.
# Set it here only if the project lives somewhere else than /srv/<project>.
# TODO(user): name of the database service in the project's compose file
DB_SERVICE="db"
# TODO(user): database name
DB_NAME="example_app"
# TODO(user): dedicated user for dumps (NOT root). The privileges it needs
# depend on the database and the options used; typically: SELECT, SHOW VIEW,
# TRIGGER, EVENT, LOCK TABLES. Check the documentation of your database
# version.
DB_BACKUP_USER="backup"
# The password of that user is NOT written here. The database container has
# to have the DB_BACKUP_PASSWORD environment variable (TODO(user): add it to
# the project's .env). This keeps the password out of this file and out of
# the host's process list.

target_dir="${STAGING_DIR}/${HOOK_NAME}"
target="${target_dir}/${DB_NAME}-$(date -u +%Y%m%dT%H%M%SZ).sql"
mkdir -p "${target_dir}"
umask 077
# Whatever happens, an unfinished dump is never left behind.
trap 'rm -f "${target}.tmp"' EXIT

cd "${PROJECT_DIR}"

# Written to a temporary file: an unfinished dump never passes for a
# complete one. MariaDB 11 images have only mariadb-dump; MySQL images have
# mysqldump. The container decides which one exists.
docker compose exec -T \
    -e "DB_BACKUP_USER=${DB_BACKUP_USER}" -e "DB_NAME=${DB_NAME}" \
    "${DB_SERVICE}" sh -c '
        export MYSQL_PWD="${DB_BACKUP_PASSWORD:?DB_BACKUP_PASSWORD is not set in the database container}"
        if command -v mariadb-dump >/dev/null 2>&1; then
            dump=mariadb-dump
        else
            dump=mysqldump
        fi
        exec "${dump}" --user="${DB_BACKUP_USER}" \
            --single-transaction --quick --routines --triggers --no-tablespaces \
            "${DB_NAME}"
    ' >"${target}.tmp"

if [[ ! -s "${target}.tmp" ]]; then
    echo "The dump of ${DB_NAME} is empty." >&2
    rm -f "${target}.tmp"
    exit 1
fi
# Both mysqldump and mariadb-dump end a complete dump with this comment.
if ! tail -n 1 "${target}.tmp" | grep -q '^-- Dump completed'; then
    echo "The dump of ${DB_NAME} is incomplete (no '-- Dump completed' line at the end)." >&2
    rm -f "${target}.tmp"
    exit 1
fi
mv "${target}.tmp" "${target}"
echo "Dump written: ${target}"
