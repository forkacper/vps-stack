# Minimal example of a project that fits vps-stack (web + application +
# database). The rules are described in docs/project-contract.md. This is a
# skeleton, not a ready configuration: application-specific places are marked
# TODO(user).
#
# Once the project is running, add its domain:
#   sudo vps-stack add-site app.example.com example-app-web:80

services:
  web:
    # TODO(user): image and configuration of the web server (e.g. nginx). It
    # has to pass the X-Forwarded-Proto and X-Forwarded-For headers received
    # from Caddy on to the application, without overwriting them with its own
    # values.
    image: example/web:TODO
    # Unique name: this is the upstream given to `add-site`.
    container_name: example-app-web
    restart: unless-stopped
    mem_limit: 128m
    # No `ports:`. Traffic from the internet gets here only through the proxy.
    networks:
      - proxy
      - internal
    depends_on:
      - app

  app:
    # TODO(user): application image. Configure trusted proxies in the
    # application (the Docker network addresses), otherwise HTTPS detection,
    # session cookies and OAuth callback URLs may be wrong. Settings for
    # common frameworks: docs/project-contract.md, section 5.
    # Built and pushed by examples/project-build-workflow.yml.example. The
    # tag comes from APP_TAG in .env, so a deploy or a rollback is a change
    # of one line there, which `vps-stack deploy` makes.
    image: ghcr.io/example-owner/example-app:${APP_TAG:?set APP_TAG in .env}
    restart: unless-stopped
    mem_limit: 512m
    env_file: .env
    networks:
      - internal
    depends_on:
      - db
    # TODO(user): application health endpoint for external monitoring, and
    # a healthcheck that uses it: `vps-stack deploy` waits for it before a
    # release counts as successful (docs/deploying.md). For example:
    # healthcheck:
    #   test: ["CMD", "curl", "-fsS", "http://localhost:8080/health"]
    #   interval: 10s
    #   timeout: 3s
    #   retries: 5
    #   start_period: 20s

  db:
    # TODO(user): database image pinned to a specific version tag.
    image: example/database:TODO
    restart: unless-stopped
    mem_limit: 768m
    env_file: .env
    volumes:
      - db-data:/var/lib/TODO
    # Internal network only. If you need access from the host (e.g. through
    # an SSH tunnel), publish on localhost only:
    # ports:
    #   - "127.0.0.1:3306:3306"
    networks:
      - internal

networks:
  # Shared network created by `vps-stack provision` (PROXY_NETWORK).
  proxy:
    external: true
  # Private network of the project: the database, cache and workers are not
  # visible to other projects or to the proxy.
  internal:

volumes:
  db-data:
